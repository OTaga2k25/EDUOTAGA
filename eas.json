{
  "cli": {
    "version": ">= 21.4.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "EAS_PACKAGE_MANAGER": "npm",
        "EAS_BUILD_WORKINGDIR": "apps/mobile"
      }
    },
    "preview": {
      "distribution": "internal",
      "env": {
        "EAS_PACKAGE_MANAGER": "npm",
        "EAS_BUILD_WORKINGDIR": "apps/mobile"
      }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "EAS_PACKAGE_MANAGER": "npm",
        "EAS_BUILD_WORKINGDIR": "apps/mobile"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
