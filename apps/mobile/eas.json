{
  "cli": {
    "version": ">= 21.4.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "EAS_PACKAGE_MANAGER": "npm"
      }
    },
    "preview": {
      "distribution": "internal",
      "env": {
        "EAS_PACKAGE_MANAGER": "npm",
        "EXPO_PUBLIC_API_URL": "https://edu.otaga.in"
      }
    },
    "production": {
      "autoIncrement": true,
      "android": {
        "buildType": "app-bundle"
      },
      "env": {
        "EAS_PACKAGE_MANAGER": "npm",
        "EXPO_PUBLIC_API_URL": "https://edu.otaga.in"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
